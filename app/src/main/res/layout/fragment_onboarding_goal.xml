<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".ui.onboarding.OnboardingGoalFragment">

    <!-- Header Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/trebuchet_ms"
        android:gravity="center"
        android:text="@string/what_is_your_goal"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/trebuchet_ms"
        android:gravity="center"
        android:text="@string/know"
        android:textColor="@color/fitme_text_secondary"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- Goal Cards Container - Positioned precisely in lower-center -->
    <LinearLayout
        android:id="@+id/containerGoals"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <!-- 1. Lose Weight Card -->
        <LinearLayout
            android:id="@+id/cardLoseWeight"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_card_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLoseWeightTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/trebuchet_ms"
                    android:text="@string/lose_weight"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLoseWeightSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/trebuchet_ms"
                    android:text="@string/burn_fat"
                    android:textColor="@color/fitme_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/ivLoseWeightIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/lose_weight"
                android:src="@drawable/ic_goal_lose_weight"
                app:tint="@color/fitme_primary" />

        </LinearLayout>

        <!-- 2. Get Fitter Card -->
        <LinearLayout
            android:id="@+id/cardGetFitter"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_card_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGetFitterTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/trebuchet_ms"
                    android:text="@string/get_fitter"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGetFitterSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/trebuchet_ms"
                    android:text="@string/tone_up"
                    android:textColor="@color/fitme_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/ivGetFitterIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/get_fitter"
                android:src="@drawable/heartbeat"
                app:tint="@color/fitme_primary" />

        </LinearLayout>

        <!-- 3. Gain Muscles Card -->
        <LinearLayout
            android:id="@+id/cardGainMuscles"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:background="@drawable/bg_card_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGainMusclesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/trebuchet_ms"
                    android:text="@string/gain_muscles"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGainMusclesSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/trebuchet_ms"
                    android:text="@string/build_mass"
                    android:textColor="@color/fitme_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/ivGainMusclesIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/gain_muscles"
                android:src="@drawable/dumbell"
                app:tint="@color/fitme_primary" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>