<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#1A1A1A"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Mark complete toggle -->
        <ImageView
            android:id="@+id/iv_mark_complete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/cd_mark_complete"
            android:src="@drawable/ic_checkbox_unchecked" />

        <!-- Thumbnail -->
        <ImageView
            android:id="@+id/iv_plan_thumbnail"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_thumbnail_rounded"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_workout" />

        <!-- Title + meta (duration · intensity) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_plan_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Wild Thing Flow"
                android:textColor="@color/fitme_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_plan_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="19 min"
                    android:textColor="@color/fitme_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:text="·"
                    android:textColor="@color/fitme_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_plan_intensity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Intensity ●●○"
                    android:textColor="@color/fitme_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Actions: overflow (edit/delete) + play (start workout) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_plan_overflow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginBottom="6dp"
                android:contentDescription="@string/cd_more_options"
                android:src="@drawable/ic_overflow_menu" />

            <ImageView
                android:id="@+id/iv_start_plan_workout"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_play_button"
                android:contentDescription="@string/cd_start_workout"
                android:padding="8dp"
                android:src="@drawable/ic_play" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>