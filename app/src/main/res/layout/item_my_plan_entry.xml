<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#1A1A1A"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Thumbnail Container with Badge -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp">

            <ImageView
                android:id="@+id/iv_plan_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_thumbnail_rounded"
                android:contentDescription="@string/cd_workout_image"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_workout" />

            <!-- Badge overlay, e.g., "New" -->
            <TextView
                android:id="@+id/tv_plan_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="4dp"
                android:background="@drawable/bg_badge"
                android:fontFamily="@font/trebuchet_ms"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="@string/badge_new"
                android:textColor="#FF5252"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Title + Subtitle tags + Duration -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_plan_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/trebuchet_ms"
                android:maxLines="1"
                android:text="@string/default_plan_title"
                android:textColor="@color/fitme_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_plan_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/trebuchet_ms"
                android:maxLines="1"
                android:text="@string/default_plan_tags"
                android:textColor="@color/fitme_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_plan_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/trebuchet_ms"
                android:text="@string/default_plan_duration"
                android:textColor="@color/fitme_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Favorite Heart Icon Centered Vertically -->
        <ImageView
            android:id="@+id/iv_favorite_toggle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="@string/cd_favorite"
            android:src="@drawable/ic_nav_favorite" />

    </LinearLayout>
</androidx.cardview.widget.CardView>