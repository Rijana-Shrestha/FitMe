<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:gravity="end"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_message_sent_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_bubble_sent"
        android:maxWidth="260dp"
        android:padding="12dp"
        android:text="Sounds good, see you there!"
        android:textColor="@color/fitme_background" />

    <TextView
        android:id="@+id/tv_message_sent_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="2:41 PM"
        android:textColor="@color/fitme_text_secondary"
        android:textSize="10sp" />
</LinearLayout>