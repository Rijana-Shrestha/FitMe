<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:gravity="start"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_message_received_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bg_bubble_received"
        android:maxWidth="260dp"
        android:padding="12dp"
        android:text="See you at the gym!"
        android:textColor="@color/fitme_text_primary" />

    <TextView
        android:id="@+id/tv_message_received_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="2:40 PM"
        android:textColor="@color/fitme_text_secondary"
        android:textSize="10sp" />
</LinearLayout>